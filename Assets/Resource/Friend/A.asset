  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a2b80edfb24e51e44881bcb2e32cb9a6, type: 3}
  m_Name: A
  m_EditorClassIdentifier: 
  conversationID: 
  nextConversation: {fileID: 0}
  lines:
  - speakerName: "H\xF9ng"
    speakerAvatar: {fileID: 0}
    content: "Alo alo, sao r\u1ED3i \xF4ng ch\u1EE7? H\xF4m nay b\xE1n \u0111\u01B0\u1EE3c
      nhi\u1EC1u kh\xF4ng?"
    typingSpeedMultiplier: 1
  - speakerName: Minh
    speakerAvatar: {fileID: 0}
    content: "T\u1EA1m \u0111\u01B0\u1EE3c. H\xF4m nay c\xF3 m\u1EA5y kh\xE1ch quen
      gh\xE9, vui l\u1EAFm."
    typingSpeedMultiplier: 1
  - speakerName: "H\xF9ng"
    speakerAvatar: {fileID: 0}
    content: "Tao v\u1EEBa \u0111i ngang, th\u1EA5y m\xE0y kh\xF4ng c\xF3 m\u1EDF
      c\u1EEDa \xE0. Hay m\xE0y \u0111\xF3ng s\u1EDBm v\u1EADy?"
    typingSpeedMultiplier: 1
  - speakerName: Minh
    speakerAvatar: {fileID: 0}
    content: "\u1EEA tao \u0111\xF3ng s\u1EDBm, m\u1EC7t qu\xE1. D\u1ECDn h\xE0ng
      t\u1EEB s\xE1ng r\u1ED3i."
    typingSpeedMultiplier: 1
  - speakerName: "H\xF9ng"
    speakerAvatar: {fileID: 0}
    content: "Nh\u1EDB ngh\u1EC9 ng\u01A1i nha, \u0111\u1EEBng c\xF3 v\u1EAFt ki\u1EC7t
      s\u1EE9c."
    typingSpeedMultiplier: 1
  - speakerName: Minh
    speakerAvatar: {fileID: 0}
    content: "Bi\u1EBFt r\u1ED3i m\xE0y \u01A1i. M\xE0y y\xEAn t\xE2m \u0111i."
    typingSpeedMultiplier: 1
