MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a2b80edfb24e51e44881bcb2e32cb9a6, type: 3}
  m_Name: Mom7
  m_EditorClassIdentifier: 
  conversationID: Mom7
  nextConversation: {fileID: 0}
  lines:
  - speakerName: "M\u1EB9"
    speakerAvatar: {fileID: 0}
    content: "Alo con, tu\u1EA7n \u0111\u1EA7u sao r\u1ED3i? C\xF3 kh\xE1ch gh\xE9
      kh\xF4ng hay \u1EBF qu\xE1?"
    typingSpeedMultiplier: 1
  - speakerName: Minh
    speakerAvatar: {fileID: 0}
    content: "C\xF3 kh\xE1ch m\u1EB9 \u01A1i, \xEDt th\xF4i nh\u01B0ng m\xE0 vui.
      M\u1EA5y ng\u01B0\u1EDDi h\xE0ng x\xF3m hay gh\xE9 bu\u1ED5i s\xE1ng."
    typingSpeedMultiplier: 1
  - speakerName: "M\u1EB9"
    speakerAvatar: {fileID: 0}
    content: "Nh\u1EDB \u0103n c\u01A1m \u0111\xFAng b\u1EEFa nha con, \u0111\u1EEBng
      c\xF3 m\u1EA3i bu\xF4n b\xE1n m\xE0 b\u1ECF b\u1EEFa. M\u1EB9 lo c\xE1i v\u1EE5
      \u0111\xF3 l\u1EAFm."
    typingSpeedMultiplier: 1
  - speakerName: Minh
    speakerAvatar: {fileID: 0}
    content: "Con \u0103n \u0111\u1EE7 r\u1ED3i m\u1EB9, kh\xF4ng c\xF3 b\u1ECF b\u1EEFa
      \u0111\xE2u."
    typingSpeedMultiplier: 1
  - speakerName: "M\u1EB9"
    speakerAvatar: {fileID: 0}
    content: "\xC0 m\xE0 con c\xF3 ch\xE0o h\xE0ng x\xF3m xung quanh ch\u01B0a? Ng\u01B0\u1EDDi
      ta \u1EDF g\u1EA7n m\xECnh, c\u01B0 x\u1EED cho \u0111\u1EB9p v\xE0o. Sau n\xE0y
      m\u1EDBi nh\u1EDD \u0111\u01B0\u1EE3c."
    typingSpeedMultiplier: 1
  - speakerName: Minh
    speakerAvatar: {fileID: 0}
    content: "R\u1ED3i m\u1EB9, con hay mang tr\xE0 bi\u1EBFu m\u1EA5y nh\xE0 g\u1EA7n
      \u0111\xF3. Ng\u01B0\u1EDDi ta c\xF3 v\u1EBB th\xEDch."
    typingSpeedMultiplier: 1
  - speakerName: Minh
    speakerAvatar: {fileID: 0}
    content: "Th\xF4i con ch\xE0o m\u1EB9, con l\xE0m vi\u1EC7c ti\u1EBFp \u0111\xE2y"
    typingSpeedMultiplier: 1
