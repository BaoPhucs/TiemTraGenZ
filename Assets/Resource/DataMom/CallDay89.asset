  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a2b80edfb24e51e44881bcb2e32cb9a6, type: 3}
  m_Name: CallDay89
  m_EditorClassIdentifier: 
  conversationID: Day89
  nextConversation: {fileID: 0}
  lines:
  - speakerName: "M\u1EB9"
    speakerAvatar: {fileID: 0}
    content: "Con \u01A1i, kh\xF4ng bi\u1EBFt sao h\xF4m nay m\u1EB9 c\u1EE9 nh\u1EDB
      con m\xE3i. G\u1ECDi cho y\xEAn t\xE2m."
    typingSpeedMultiplier: 1
  - speakerName: Minh
    speakerAvatar: {fileID: 0}
    content: "Con \u0111\xE2y m\u1EB9. Con \u0111ang \u1ED5n."
    typingSpeedMultiplier: 1
  - speakerName: "M\u1EB9"
    speakerAvatar: {fileID: 0}
    content: "Ba th\xE1ng r\u1ED3i \u0111\xF3, con bi\u1EBFt kh\xF4ng? M\u1EB9 nh\u1EDB
      ng\xE0y con kh\xF3a c\u1EEDa nh\xE0, x\xE1ch \u0111\u1ED3 \u0111i v\u1EDBi
      c\xE1i ba l\xF4 c\u0169."
    typingSpeedMultiplier: 1
  - speakerName: Minh
    speakerAvatar: {fileID: 0}
    content: "Con c\u0169ng nh\u1EDB ng\xE0y \u0111\xF3 m\u1EB9. H\u1ED3i \u0111\xF3
      con s\u1EE3 l\u1EAFm, nh\u01B0ng kh\xF4ng d\xE1m n\xF3i."
    typingSpeedMultiplier: 1
  - speakerName: "M\u1EB9"
    speakerAvatar: {fileID: 0}
    content: "D\xF9 k\u1EBFt qu\u1EA3 ra sao, con \u0111\xE3 d\xE1m th\u1EED. M\xE0
      v\u1EDBi m\u1EB9, v\u1EADy l\xE0 \u0111\u1EE7 r\u1ED3i."
    typingSpeedMultiplier: 1
  - speakerName: Minh
    speakerAvatar: {fileID: 0}
    content: "(gi\u1ECDng kh\u1EBD) C\u1EA3m \u01A1n m\u1EB9. Con s\u1EBD kh\xF4ng
      ph\u1EE5 l\xF2ng m\u1EB9 \u0111\xE2u."
    typingSpeedMultiplier: 1
  - speakerName: "M\u1EB9"
    speakerAvatar: {fileID: 0}
    content: "M\u1EB9 th\u01B0\u01A1ng con. R\xE1ng l\xEAn nha."
    typingSpeedMultiplier: 1
  - speakerName: Minh
    speakerAvatar: {fileID: 0}
    content: "Con c\u1EA3m \u01A1n m\u1EB9 \u1EA1"
    typingSpeedMultiplier: 1
