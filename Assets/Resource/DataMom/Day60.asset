  m_Script: {fileID: 11500000, guid: a2b80edfb24e51e44881bcb2e32cb9a6, type: 3}
  m_Name: Day60
  m_EditorClassIdentifier: 
  conversationID: 
  nextConversation: {fileID: 0}
  lines:
  - speakerName: "M\u1EB9"
    speakerAvatar: {fileID: 0}
    content: "Con \u01A1i, m\u1EB9 c\xF3 nghe ch\xFA T\xE1m n\xF3i m\u1EA5y nh\xE0
      g\u1EA7n ti\u1EC7m con h\u01A1i... kh\xF3 ch\u1ECBu g\xEC \u0111\xF3."
    typingSpeedMultiplier: 1
  - speakerName: Minh
    speakerAvatar: {fileID: 0}
    content: "Ui... th\u1EADt m\u1EB9? Con kh\xF4ng bi\u1EBFt. Ch\u1EAFc v\xEC d\u1EA1o
      n\xE0y con b\u1EADn qu\xE1 kh\xF4ng \u0111\u1EC3 \xFD."
    typingSpeedMultiplier: 1
  - speakerName: "M\u1EB9"
    speakerAvatar: {fileID: 0}
    content: "M\u1EB9 kh\xF4ng bi\u1EBFt chuy\u1EC7n g\xEC, nh\u01B0ng m\xE0 h\xE0ng
      x\xF3m quan tr\u1ECDng l\u1EAFm con \xE0. Ng\u01B0\u1EDDi ta c\xF3 th\u1EC3
      gi\xFAp m\xECnh l\xFAc kh\xF3."
    typingSpeedMultiplier: 1
  - speakerName: Minh
    speakerAvatar: {fileID: 0}
    content: "D\u1EA1 con bi\u1EBFt. \u0110\u1EC3 con gh\xE9 th\u0103m m\u1EA5y nh\xE0
      \u0111\xF3."
    typingSpeedMultiplier: 1
  - speakerName: "M\u1EB9"
    speakerAvatar: {fileID: 0}
    content: "Con th\u1EED gh\xE9 th\u0103m h\u1ECD, bi\u1EBFu g\xF3i tr\xE0 hay
      c\xE1i g\xEC \u0111\xF3. Kh\xF4ng t\u1ED1n nhi\u1EC1u nh\u01B0ng ng\u01B0\u1EDDi
      ta nh\u1EDB ho\xE0i."
    typingSpeedMultiplier: 1
  - speakerName: Minh
    speakerAvatar: {fileID: 0}
    content: "\xDD hay \u0111\xF3 m\u1EB9. Con l\xE0m v\u1EADy \u0111\u01B0\u1EE3c.
      C\u1EA3m \u01A1n m\u1EB9 nh\u1EAFc."
    typingSpeedMultiplier: 1
