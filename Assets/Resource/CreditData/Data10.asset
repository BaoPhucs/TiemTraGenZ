  conversationID: 
  nextConversation: {fileID: 0}
  lines:
  - speakerName: "S\u1ED1 l\u1EA1"
    speakerAvatar: {fileID: 0}
    content: "Alo, cho h\u1ECFi... \u0111\xE2y c\xF3 ph\u1EA3i s\u1ED1 c\u1EE7a ch\u1EE7
      ti\u1EC7m tr\xE0 kh\xF4ng?"
    typingSpeedMultiplier: 1
  - speakerName: Minh
    speakerAvatar: {fileID: 0}
    content: "D\u1EA1, t\xF4i nghe. Ai v\u1EADy?"
    typingSpeedMultiplier: 1
  - speakerName: "S\u1ED1 l\u1EA1"
    speakerAvatar: {fileID: 0}
    content: "\xC0, t\xF4i l\xE0 T\xE0i, b\xEAn ph\xEDa anh H\xF9ng. Anh nh\u1EDD
      t\xF4i nh\u1EAFc nh\u1ECF v\u1EC1 kho\u1EA3n vay h\u1ED3i \u0111\u1EA7u n\u0103m."
    typingSpeedMultiplier: 1
  - speakerName: Minh
    speakerAvatar: {fileID: 0}
    content: "\u1EEA... t\xF4i bi\u1EBFt r\u1ED3i. T\xF4i \u0111ang c\u1ED1 g\u1EAFng."
    typingSpeedMultiplier: 0
  - speakerName: "S\u1ED1 l\u1EA1"
    speakerAvatar: {fileID: 0}
    content: "Kh\xF4ng c\xF3 g\xEC g\u1EA5p \u0111\xE2u, ch\u1EC9 nh\u1EAFc th\xF4i.
      C\u1EE9 l\xE0m \u0103n t\u1ED1t l\xE0 \u0111\u01B0\u1EE3c. Ch\xE0o."
    typingSpeedMultiplier: 1
  - speakerName: Minh
    speakerAvatar: {fileID: 0}
    content: "(th\u1EDF nh\u1EB9) Ch\xE0o."
    typingSpeedMultiplier: 1
