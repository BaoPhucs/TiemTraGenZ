  canvasGroup: {fileID: 1419232863}
  endingText: {fileID: 937987269}
  backToMenuButton: {fileID: 1833251470}
  textBadEnding: "Ti\u1EC7m Tr\xE0 ch\xECm v\xE0o qu\xEAn l\xE3ng. Minh tr\u1EDF
    l\u1EA1i v\u1EDBi m\xE0n h\xECnh m\xE1y t\xEDnh v\xE0 nh\u1EEFng deadline v\xF4
    v\u1ECB n\u01A1i c\xF4ng s\u1EDF..."
  textNormalEnding: "Ti\u1EC7m Tr\xE0 ph\u1EE7 s\xF3ng kh\u1EAFp c\u1EA3 n\u01B0\u1EDBc
    v\u1EDBi 50 chi nh\xE1nh. Minh tr\u1EDF th\xE0nh m\u1ED9t tri\u1EC7u ph\xFA,
    nh\u01B0ng m\u1ED7i l\u1EA7n u\u1ED1ng ly tr\xE0 c\xF4ng nghi\u1EC7p \u1EA5y,
    v\u1ECB \u0111\u1EAFng c\u1EE7a s\u1EF1 m\u1EA5t m\xE1t l\u1EA1i hi\u1EC7n l\xEAn..."
  textTrueEnding: "Ti\u1EC7m Tr\xE0 kh\xF4ng tr\u1EDF th\xE0nh chu\u1ED7i kh\u1ED5ng
    l\u1ED3, nh\u01B0ng l\u1EA1i l\xE0 t\xE0i s\u1EA3n v\xF4 gi\xE1 c\u1EE7a khu
    ph\u1ED1. N\xF3 l\xE0 \u0111i\u1EC3m giao thoa gi\u1EEFa h\u01B0\u01A1ng v\u1ECB
    truy\u1EC1n th\u1ED1ng v\xE0 nh\u1ECBp s\u1ED1ng tr\u1EBB gen Z..."
